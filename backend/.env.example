# Copia este archivo como .env (local) o configura estas variables en Render. NUNCA subas el .env a GitHub.

# Dirección de tu proyecto de Supabase (sin /rest/v1)
SUPABASE_URL=https://ylrbqjnxqdeatvqduqrc.supabase.co

# Clave pública (publishable). La API la usa junto con el token de cada usuario,
# así las reglas de seguridad (RLS) de la base de datos siguen aplicándose.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Páginas autorizadas a llamar a la API, separadas por coma, sin barra final
ALLOWED_ORIGINS=https://petgo.netlify.app,https://estjosepiedrahita-lab.github.io,http://localhost:5500

# Opcionales
PORT=3000
RATE_LIMIT_PER_MIN=120
TRUST_PROXY=true
